/-! ## Kernel checkers (pure sift / `ZMod 25` arithmetic; no new axioms) -/

/-- The conjugation matrix of `n` on `H`'s char vectors (echelon basis `B`), q=2:
row `i` is `expVec2_B (n⁻¹ gᵢ n)` — exactly `conjMatrix` in
`Generators/Twin2/NormGen.lean`. -/
def conjMatrixL2 (B : List Coordinates) (n : Coordinates) : List (List (ZMod 25)) :=
  B.map (fun gi => expVec2 B (conjC 2 (invC 2 n) gi))

/-- **(a) Membership.** Every `n ∈ normGens r` sifts into the link-1 normalizer
base `getB (normIdxData r)`. -/
def normGenMemCheck (r : Nat) : Bool :=
  (normGens.getD r []).all (fun g => siftB 2 (getB (normIdxData.getD r 0)) g)

/-- **(b) Well-formedness.** `normGens r` is an echelon `wfB'` base. -/
def normGenWfCheck (r : Nat) : Bool := wfB' 2 (normGens.getD r [])

/-- **(c) Order match.** `normGens r` and the link-1 base have equal length. -/
def normGenLenCheck (r : Nat) : Bool :=
  Nat.beq (normGens.getD r []).length (getB (normIdxData.getD r 0)).length

/-- **(d) Realization.** The emitted matrices are exactly the conjugation
matrices of `normGens r`'s elements on `B = getB (classRepsData r)`. -/
def normRealizeCheck (r : Nat) : Bool :=
  decide ((normMats.getD r []) =
    (normGens.getD r []).map (conjMatrixL2 (getB (classRepsData.getD r 0))))

end LeanDring.P5Presentation.Q2
