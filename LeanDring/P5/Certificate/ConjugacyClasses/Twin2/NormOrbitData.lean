/-! ## Kernel-cheap per-representative checkers (q=2, against `repChars2`) -/

/-- Per-`(r,k,p)` action fact: the `k`-th generator's matrix maps `chars[p]` to
the emitted permutation target, whose orbit label matches. -/
def orbActOK (r k p : Nat) : Bool :=
  Nat.blt (((normActPos.getD r []).getD k []).getD p 0) (repChars2.getD r []).length &&
  decide (actVecZ ((normMats.getD r []).getD k []) ((repChars2.getD r []).getD p []) =
    (repChars2.getD r []).getD (((normActPos.getD r []).getD k []).getD p 0) []) &&
  Nat.beq ((normLabel.getD r []).getD (((normActPos.getD r []).getD k []).getD p 0) 0)
    ((normLabel.getD r []).getD p 0)

/-- **Action + label-invariance check** for rep `r`. -/
def checkAct (r : Nat) : Bool :=
  (List.range (normMats.getD r []).length).all (fun k =>
    (List.range (repChars2.getD r []).length).all (fun p => orbActOK r k p))

/-- Per-`(r,p)` spanning-tree fact. -/
def orbTreeOK (r p : Nat) : Bool :=
  ((normIsRep.getD r []).getD p false &&
    (Nat.beq ((normTreeDepth.getD r []).getD p 0) 0 &&
      Nat.beq ((normLabel.getD r []).getD p 0) p)) ||
  (!((normIsRep.getD r []).getD p false) &&
    (Nat.blt ((normTreeGen.getD r []).getD p 0) (normMats.getD r []).length &&
     Nat.blt ((normTreePar.getD r []).getD p 0) (repChars2.getD r []).length &&
     Nat.blt ((normTreeDepth.getD r []).getD ((normTreePar.getD r []).getD p 0) 0)
       ((normTreeDepth.getD r []).getD p 0) &&
     Nat.beq (((normActPos.getD r []).getD ((normTreeGen.getD r []).getD p 0) []).getD
       ((normTreePar.getD r []).getD p 0) 0) p &&
     Nat.beq ((normLabel.getD r []).getD ((normTreePar.getD r []).getD p 0) 0)
       ((normLabel.getD r []).getD p 0)))

/-- **BFS spanning-tree check** for rep `r`. -/
def checkTree (r : Nat) : Bool :=
  (List.range (repChars2.getD r []).length).all (fun p => orbTreeOK r p)

/-- Length sanity of the per-position data. -/
def checkLen (r : Nat) : Bool :=
  let n := (repChars2.getD r []).length
  Nat.beq (normLabel.getD r []).length n && Nat.beq (normIsRep.getD r []).length n &&
  Nat.beq (normTreeGen.getD r []).length n && Nat.beq (normTreePar.getD r []).length n &&
  Nat.beq (normTreeDepth.getD r []).length n &&
  Nat.beq (normMats.getD r []).length (normActPos.getD r []).length

/-- Number of orbits of rep `r` = number of orbit representatives. -/
def orbitCountR (r : Nat) : Nat := ((normIsRep.getD r []).filter (· = true)).length

/-- Orbit fibre of rep `r` split by the order of the representative character. -/
def orbFibreO1 (r : Nat) : Nat :=
  ((List.range (repChars2.getD r []).length).filter (fun p =>
    (normIsRep.getD r []).getD p false && Nat.beq (charOrdZ ((repChars2.getD r []).getD p [])) 1)).length
def orbFibreO5 (r : Nat) : Nat :=
  ((List.range (repChars2.getD r []).length).filter (fun p =>
    (normIsRep.getD r []).getD p false && Nat.beq (charOrdZ ((repChars2.getD r []).getD p [])) 5)).length
def orbFibreO25 (r : Nat) : Nat :=
  ((List.range (repChars2.getD r []).length).filter (fun p =>
    (normIsRep.getD r []).getD p false && Nat.beq (charOrdZ ((repChars2.getD r []).getD p [])) 25)).length

