theorem normData_lengths :
    normIdxData.length = 148 ∧ normMats.length = 148 ∧ normActPos.length = 148 ∧
    normLabel.length = 148 ∧ normIsRep.length = 148 ∧ normTreeGen.length = 148 ∧
    normTreePar.length = 148 ∧ normTreeDepth.length = 148 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide

