/-! ## Standard generators, moves, and labels -/

/-- The `k`-th standard pc generator as an element of `Coordinate 1`. -/
def gElt : Nat → Coordinate 1
  | 0 => ((1,0,0,0,0) : Coordinates)
  | 1 => ((0,1,0,0,0) : Coordinates)
  | 2 => ((0,0,1,0,0) : Coordinates)
  | 3 => ((0,0,0,1,0) : Coordinates)
  | 4 => ((0,0,0,0,1) : Coordinates)
  | _ => ((0,0,0,0,0) : Coordinates)

/-- The target index of `conjTab`'s move `(k, i)`. -/
def conjMove (k i : Nat) : Nat := (conjTab.getD k []).getD i 0

/-- Class label of index `i`. -/
def classOfD (i : Nat) : Nat := classOfData.getD i 0

/-- Representative index of the class containing `i`. -/
def repIdx (i : Nat) : Nat := classRepsData.getD (classOfD i) 0

/-! ## The conjugation-move checker (zip form, kernel-cheap)

Iterating over `allBasesRaw` zipped with a `conjTab` row visits each source base
once (no `getD` into the 676-entry `allBases` for the source), which keeps the
per-row kernel `decide` memory bounded. -/

/-- Row `k` paired: each `(base_i, j)` with `j = conjMove k i`. -/
def conjPairs (k : Nat) : List (List Coordinates × Nat) :=
  allBasesRaw.zip (conjTab.getD k [])

/-- Checker for one `(base_i, j)` pair: `j` in range, matching order, and every
generator of `base_i`, conjugated by `gk`, sifts into `getB j`. -/
def conjEntryOK2 (gk : Coordinates) (p : List Coordinates × Nat) : Bool :=
  Nat.blt p.2 676 &&
  Nat.beq p.1.length (getB p.2).length &&
  p.1.all (fun gen => siftB 1 (getB p.2) (conjC 1 gk gen))

/-- The whole conjugation row-`k` check. -/
def conjRowCheck (k : Nat) : Bool := (conjPairs k).all (conjEntryOK2 (gElt k))

/-! ## The class-invariance checker (zip form) -/

/-- Row `k` paired: each `(classOf i, j)` with `j = conjMove k i`. -/
def classInvPairs (k : Nat) : List (Nat × Nat) := classOfData.zip (conjTab.getD k [])

/-- Checker: the target keeps the source's class label. -/
def classInvEntryOK2 (p : Nat × Nat) : Bool := Nat.beq (classOfData.getD p.2 0) p.1

/-- The whole class-invariance row-`k` check. -/
def classInvRowCheck (k : Nat) : Bool := (classInvPairs k).all classInvEntryOK2

/-! ## BFS-tree, bound, and singleton (normal) checkers -/

/-- BFS-tree validity at index `i`: either a representative at depth `0`, or a
valid parent `(k, j)` with smaller depth, same class, and `conjMove k j = i`. -/
def treeEntryOK (i : Nat) : Bool :=
  (isRepData.getD i false && Nat.beq (depthData.getD i 0) 0) ||
  (!(isRepData.getD i false) &&
    (Nat.blt (parentKData.getD i 0) 5 && Nat.blt (parentJData.getD i 0) 676 &&
     Nat.blt (depthData.getD (parentJData.getD i 0) 0) (depthData.getD i 0) &&
     Nat.beq (classOfD (parentJData.getD i 0)) (classOfD i) &&
     Nat.beq (conjMove (parentKData.getD i 0) (parentJData.getD i 0)) i))

def treeCheckAll : Bool := (List.range 676).all treeEntryOK

/-- The number of subgroups in class `c` (occurrences of `c` among the 676 labels). -/
def classSizeNat (c : Nat) : Nat := classOfData.count c

/-- Data flag: index `i`'s subgroup is fixed by every generator-conjugation. -/
def isNormalIdx (i : Nat) : Bool :=
  (List.range 5).all (fun k => Nat.beq (conjMove k i) i)

/-! ## Chunked `List.all` assembly over `range 676` -/

theorem all_split {α} (l : List α) (f : α → Bool) (n : ℕ) :
    l.all f = ((l.take n).all f && (l.drop n).all f) := by
  conv_lhs => rw [← List.take_append_drop n l]
  rw [List.all_append]

theorem all676_of_chunks (f : ℕ → Bool)
    (h0 : ((List.range 676).take 169).all f = true)
    (h1 : (((List.range 676).drop 169).take 169).all f = true)
    (h2 : ((((List.range 676).drop 169).drop 169).take 169).all f = true)
    (h3 : ((((List.range 676).drop 169).drop 169).drop 169).all f = true) :
    (List.range 676).all f = true := by
  rw [all_split (List.range 676) f 169,
      all_split ((List.range 676).drop 169) f 169,
      all_split (((List.range 676).drop 169).drop 169) f 169]
  simp only [h0, h1, h2, h3, Bool.and_self]

end LeanDring.P5Presentation
