/-! ## Per-representative checkers (indexed by `r`) -/

/-- The embedded rows really are the `expVec2` q=2 collection relators (the sift). -/
def checkRows2 (r : Nat) : Bool :=
  decide (repPR2.getD r [] = powRowsE2 (repBases2.getD r [])) &&
  decide (repCR2.getD r [] = commRowsE2 (repBases2.getD r []))

/-- Every embedded character vector passes the fast checker. -/
def checkValid2 (r : Nat) : Bool :=
  (repChars2.getD r []).all (charOKrows (repPR2.getD r []) (repCR2.getD r []))

/-- The character-vector list is duplicate-free. -/
def checkNodup2 (r : Nat) : Bool := decide (repChars2.getD r []).Nodup

/-- The character count matches the aggregate `charCounts` entry (twin-invariant). -/
def checkCount2 (r : Nat) : Bool :=
  Nat.beq (repChars2.getD r []).length (charCounts.getD r 0)

/-- The embedded basis is the genuine q=2 echelon basis of `reps r`. -/
def checkBasis2 (r : Nat) : Bool :=
  decide (repBases2.getD r [] = getB (classRepsData.getD r 0))

