import LeanDring.P5.Certificate.Characters.Twin1.CharCert
import LeanDring.P5.Certificate.Characters.Twin2.CharData

/-!
# Per-representative character-vector certification (character certification, twin q=2)

The q=2 twin of `LeanDring.P5.Certificate.Characters.Twin1.CharCert`. For each of
the 148 conjugacy-class representatives `H = Q2.reps r` we embed its full list of
q=2 linear-character exponent vectors (`repChars2`), the relation rows of its q=2
echelon basis (`repPR2`, `repCR2`) and the basis itself (`repBases2`). The
sift-free fast checker `charOKrows` is group-independent (pure `ZMod 25` linear
algebra) so it is reused verbatim; the group law enters only through
`powRowsE2`/`commRowsE2` (built with `mpow 2` and the q=2 `commutatorC`).
`charOKrows_iff2` bridges the fast checker to the genuine q=2 collection-relation
checker `charOK2` of `LeanDring.P5.Certificate.Characters.Twin2.CharData`.

Twin divergence (measured by `LeanDring/P5/Certificate/Generators/Twin2/GenChar.lean`): the bases differ in 50 reps, the power
rows in 106 reps, the commutator rows in 0, and the character vector sets in 34
(all `k ≤ 3`); the counts are invariant. For the `k ≥ 4` reps the q=1 character
vectors remain `charOK2`-valid on the q=2 basis, so `repChars2` reuses them there.
-/

namespace LeanDring.P5Presentation

namespace Q2

open Fin.NatCast

-- emitted data literals; lines are machine-generated
set_option linter.style.longLine false
set_option maxRecDepth 100000

/-! ## The q=2 relation rows and the bridge to `charOK2` -/

/-- The q=2 power relation rows of a basis `B`: `expVec2 B (g_i^5)` per pivot. -/
def powRowsE2 (B : List Coordinates) : List (List (ZMod 25)) :=
  (List.range B.length).map (fun i => expVec2 B (mpow 2 (B.getD i zc) 5))

/-- The q=2 commutator relation rows of a basis `B`: `expVec2 B [g_i,g_j]`, `i<j`. -/
def commRowsE2 (B : List Coordinates) : List (List (ZMod 25)) :=
  (List.range B.length).flatMap (fun i =>
    ((List.range B.length).filter (fun j => Nat.blt i j)).map (fun j =>
      expVec2 B (commutatorC (B.getD i zc) (B.getD j zc))))

theorem powRowsE2_getD (B : List Coordinates) (i : Nat) (hi : i < B.length) :
    (powRowsE2 B).getD i [] = expVec2 B (mpow 2 (B.getD i zc) 5) := by
  unfold powRowsE2
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hi]
  rfl

/-- **The bridge (q=2).** For the genuine q=2 relation rows, the group-independent
fast checker `charOKrows` agrees with the q=2 collection-relation checker
`charOK2`. Structural copy of `charOKrows_iff`. -/
theorem charOKrows_iff2 (B : List Coordinates) (e : List (ZMod 25)) :
    charOKrows (powRowsE2 B) (commRowsE2 B) e = true ↔ charOK2 B e = true := by
  unfold charOKrows charOK2
  rw [Bool.and_eq_true, Bool.and_eq_true]
  have hlen : (powRowsE2 B).length = B.length := by
    unfold powRowsE2; rw [List.length_map, List.length_range]
  constructor
  · rintro ⟨hp, hc⟩
    refine ⟨?_, ?_⟩
    · rw [List.all_eq_true] at hp ⊢
      intro i hi
      have hi' : i < B.length := by rw [List.mem_range] at hi; exact hi
      have := hp i (by rw [List.mem_range, hlen]; exact hi')
      rwa [powRowsE2_getD B i hi'] at this
    · rw [List.all_eq_true]
      intro i hi
      rw [List.all_eq_true]
      intro j hj
      rw [List.mem_range] at hi hj
      by_cases hij : Nat.blt i j = true
      · simp only [hij, Bool.not_true, Bool.false_or]
        rw [List.all_eq_true] at hc
        apply hc
        unfold commRowsE2
        rw [List.mem_flatMap]
        exact ⟨i, List.mem_range.mpr hi, List.mem_map.mpr
          ⟨j, List.mem_filter.mpr ⟨List.mem_range.mpr hj, hij⟩, rfl⟩⟩
      · simp only [Bool.not_eq_true] at hij
        rw [hij]; rfl
  · rintro ⟨hp, hc⟩
    refine ⟨?_, ?_⟩
    · rw [List.all_eq_true] at hp ⊢
      intro i hi
      rw [List.mem_range, hlen] at hi
      rw [powRowsE2_getD B i hi]
      exact hp i (List.mem_range.mpr hi)
    · rw [List.all_eq_true]
      intro row hrow
      unfold commRowsE2 at hrow
      rw [List.mem_flatMap] at hrow
      obtain ⟨i, hi, hrow2⟩ := hrow
      rw [List.mem_map] at hrow2
      obtain ⟨j, hj, rfl⟩ := hrow2
      rw [List.mem_filter] at hj
      obtain ⟨hjr, hij⟩ := hj
      rw [List.all_eq_true] at hc
      have hci := hc i hi
      rw [List.all_eq_true] at hci
      have := hci j hjr
      rw [List.mem_range] at hi
      simp only [hij, Bool.not_true, Bool.false_or] at this
      exact this

/-- Lift a batched fast-check to genuine `charOK2`-validity for one basis. -/
theorem all_charOK_of_rows2 (B : List Coordinates) (cs PR CR : List (List (ZMod 25)))
    (hPR : PR = powRowsE2 B) (hCR : CR = commRowsE2 B)
    (h : cs.all (charOKrows PR CR) = true) : cs.all (charOK2 B) = true := by
  subst hPR hCR
  rw [List.all_eq_true] at h ⊢
  intro e he
  exact (charOKrows_iff2 B e).mp (h e he)

