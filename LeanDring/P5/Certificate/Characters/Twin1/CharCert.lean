theorem repBases_length : repBases.length = 148 := by decide
theorem repPR_length : repPR.length = 148 := by decide
theorem repCR_length : repCR.length = 148 := by decide
theorem repChars_length : repChars.length = 148 := by decide

/-! ## Per-representative checkers (indexed by `r`) -/

/-- The embedded rows really are the `expVec` collection relators (the sift). -/
def checkRows (r : Nat) : Bool :=
  decide (repPR.getD r [] = powRowsE (repBases.getD r [])) &&
  decide (repCR.getD r [] = commRowsE (repBases.getD r []))

/-- Every embedded character vector passes the fast checker. -/
def checkValid (r : Nat) : Bool :=
  (repChars.getD r []).all (charOKrows (repPR.getD r []) (repCR.getD r []))

/-- The character-vector list is duplicate-free. -/
def checkNodup (r : Nat) : Bool := decide (repChars.getD r []).Nodup

/-- The character count matches the aggregate `charCounts` entry. -/
def checkCount (r : Nat) : Bool :=
  Nat.beq (repChars.getD r []).length (charCounts.getD r 0)

/-- The embedded basis is the genuine echelon basis of `reps r`. -/
def checkBasis (r : Nat) : Bool :=
  decide (repBases.getD r [] = getB (classRepsData.getD r 0))

/-! ## Chunk-assembly helper (mirrors `all676_of_chunks`) -/

theorem all148_of_chunks (f : ℕ → Bool)
    (h0 : ((List.range 148).take 37).all f = true)
    (h1 : (((List.range 148).drop 37).take 37).all f = true)
    (h2 : ((((List.range 148).drop 37).drop 37).take 37).all f = true)
    (h3 : ((((List.range 148).drop 37).drop 37).drop 37).all f = true) :
    (List.range 148).all f = true := by
  rw [all_split (List.range 148) f 37,
      all_split ((List.range 148).drop 37) f 37,
      all_split (((List.range 148).drop 37).drop 37) f 37]
  simp only [h0, h1, h2, h3, Bool.and_self]

end LeanDring.P5Presentation
