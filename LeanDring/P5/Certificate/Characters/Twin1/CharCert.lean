import LeanDring.P5.Certificate.Characters.Twin1.CharData

/-!
# Per-representative character-vector certification

For every one of the 148 conjugacy-class representatives `H = reps r` we embed
its full list of linear-character exponent vectors (`repChars`), together with
the relation rows of its echelon basis (`repPR`, `repCR`) and the basis itself
(`repBases`). The heavy work — verifying that the embedded rows really are the
`expVec` images of the collection relators — is done once per representative by
kernel `decide` (the sift), and is split across the sibling
`LeanDring.P5.Certificate.Characters.Twin1.CharRows.Chunk01`–`Chunk04` files.

The per-vector validity check is then reduced to **pure `ZMod 25` linear
algebra** (`charOKrows`): a vector is valid iff it annihilates each embedded
commutator row and satisfies each embedded power row. `charOKrows_iff` proves
this equals the genuine `charOK B` checker whenever the rows are the real
`powRowsE B` / `commRowsE B`, so the cheap batched checks upgrade to certified
`charOK`-validity.
-/

namespace LeanDring.P5Presentation

open Fin.NatCast

-- emitted data literals; lines are machine-generated
set_option linter.style.longLine false
set_option maxRecDepth 100000

/-! ## The fast row-based checker and its bridge to `charOK` -/

/-- Fast checker: `e` passes iff it satisfies every precomputed power row
(`dotZ e (PR i) = 5 · e_i`) and kills every precomputed commutator row
(`dotZ e row = 0`). Pure `ZMod 25` arithmetic — no sift. -/
def charOKrows (PR CR : List (List (ZMod 25))) (e : List (ZMod 25)) : Bool :=
  ((List.range PR.length).all (fun i => decide (dotZ e (PR.getD i []) = 5 * e.getD i 0))) &&
  (CR.all (fun row => decide (dotZ e row = 0)))

/-- The power relation rows of a basis `B`: `expVec B (g_i^5)` for each pivot. -/
def powRowsE (B : List Coordinates) : List (List (ZMod 25)) :=
  (List.range B.length).map (fun i => expVec B (mpow 1 (B.getD i zc) 5))

/-- The commutator relation rows of a basis `B`: `expVec B [g_i,g_j]`, `i<j`. -/
def commRowsE (B : List Coordinates) : List (List (ZMod 25)) :=
  (List.range B.length).flatMap (fun i =>
    ((List.range B.length).filter (fun j => Nat.blt i j)).map (fun j =>
      expVec B (commutatorC (B.getD i zc) (B.getD j zc))))

theorem powRowsE_getD (B : List Coordinates) (i : Nat) (hi : i < B.length) :
    (powRowsE B).getD i [] = expVec B (mpow 1 (B.getD i zc) 5) := by
  unfold powRowsE
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hi]
  rfl

/-- **The bridge.** For the genuine relation rows, the fast checker `charOKrows`
agrees with the collection-relation checker `charOK`. -/
theorem charOKrows_iff (B : List Coordinates) (e : List (ZMod 25)) :
    charOKrows (powRowsE B) (commRowsE B) e = true ↔ charOK B e = true := by
  unfold charOKrows charOK
  rw [Bool.and_eq_true, Bool.and_eq_true]
  have hlen : (powRowsE B).length = B.length := by
    unfold powRowsE; rw [List.length_map, List.length_range]
  constructor
  · rintro ⟨hp, hc⟩
    refine ⟨?_, ?_⟩
    · rw [List.all_eq_true] at hp ⊢
      intro i hi
      have hi' : i < B.length := by rw [List.mem_range] at hi; exact hi
      have := hp i (by rw [List.mem_range, hlen]; exact hi')
      rwa [powRowsE_getD B i hi'] at this
    · rw [List.all_eq_true]
      intro i hi
      rw [List.all_eq_true]
      intro j hj
      rw [List.mem_range] at hi hj
      by_cases hij : Nat.blt i j = true
      · simp only [hij, Bool.not_true, Bool.false_or]
        rw [List.all_eq_true] at hc
        apply hc
        unfold commRowsE
        rw [List.mem_flatMap]
        exact ⟨i, List.mem_range.mpr hi, List.mem_map.mpr
          ⟨j, List.mem_filter.mpr ⟨List.mem_range.mpr hj, hij⟩, rfl⟩⟩
      · simp only [Bool.not_eq_true] at hij
        rw [hij]; rfl
  · rintro ⟨hp, hc⟩
    refine ⟨?_, ?_⟩
    · rw [List.all_eq_true] at hp ⊢
      intro i hi
      rw [List.mem_range, hlen] at hi
      rw [powRowsE_getD B i hi]
      exact hp i (List.mem_range.mpr hi)
    · rw [List.all_eq_true]
      intro row hrow
      unfold commRowsE at hrow
      rw [List.mem_flatMap] at hrow
      obtain ⟨i, hi, hrow2⟩ := hrow
      rw [List.mem_map] at hrow2
      obtain ⟨j, hj, rfl⟩ := hrow2
      rw [List.mem_filter] at hj
      obtain ⟨hjr, hij⟩ := hj
      rw [List.all_eq_true] at hc
      have hci := hc i hi
      rw [List.all_eq_true] at hci
      have := hci j hjr
      rw [List.mem_range] at hi
      simp only [hij, Bool.not_true, Bool.false_or] at this
      exact this

/-- Lift a batched fast-check to genuine `charOK`-validity for one basis. -/
theorem all_charOK_of_rows (B : List Coordinates) (cs PR CR : List (List (ZMod 25)))
    (hPR : PR = powRowsE B) (hCR : CR = commRowsE B)
    (h : cs.all (charOKrows PR CR) = true) : cs.all (charOK B) = true := by
  subst hPR hCR
  rw [List.all_eq_true] at h ⊢
  intro e he
  exact (charOKrows_iff B e).mp (h e he)

