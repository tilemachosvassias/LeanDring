/-- All 676 subgroup bases, ordered by subgroup order `5^0 … 5^5`. -/
def allBases : List (List (Coordinate 2)) :=
  sub0 ++ sub1 ++ sub2 ++ sub3 ++ sub4 ++ sub5

/-- **Cardinality of the inventory.** Exactly `676` bases. -/
theorem allBases_card : allBases.length = 676 := by decide

/-- **Per-order strata.** Counts of subgroups of order `5^0,…,5^5` = `[1,156,306,181,31,1]`. -/
theorem allBases_strata :
    (List.range 6).map (fun k => (allBases.filter (fun b => decide (b.length = k))).length)
      = [1, 156, 306, 181, 31, 1] := by decide

-- file-level maxHeartbeats: dozens of decide-heavy declarations below need it
set_option linter.style.setOption false
set_option maxHeartbeats 100000000

theorem wf0 : sub0.all (fun b => wfB' 2 b) = true := by decide
theorem wf1_0 : sub1_0.all (fun b => wfB' 2 b) = true := by decide
theorem wf1_1 : sub1_1.all (fun b => wfB' 2 b) = true := by decide
theorem wf1_2 : sub1_2.all (fun b => wfB' 2 b) = true := by decide
theorem wf1_3 : sub1_3.all (fun b => wfB' 2 b) = true := by decide
theorem wf1_4 : sub1_4.all (fun b => wfB' 2 b) = true := by decide
theorem wf1_5 : sub1_5.all (fun b => wfB' 2 b) = true := by decide
theorem wf2 : sub2.all (fun b => wfB' 2 b) = true := by decide
theorem wf3 : sub3.all (fun b => wfB' 2 b) = true := by decide
theorem wf4 : sub4.all (fun b => wfB' 2 b) = true := by decide
theorem wf5 : sub5.all (fun b => wfB' 2 b) = true := by decide

/-- Every one of the 676 bases passes the pure-`Bool` well-formedness test. -/
theorem allBases_wfB' : allBases.all (fun b => wfB' 2 b) = true := by
  simp only [allBases, sub1, List.all_append, wf0, wf1_0, wf1_1, wf1_2, wf1_3, wf1_4, wf1_5,
    wf2, wf3, wf4, wf5, Bool.and_self]

/-- Every one of the 676 bases is a genuine well-formed echelon pcgs (`wfB`). -/
theorem allBases_wfB : ∀ b ∈ allBases, wfB 2 b = true := by
  have h := List.all_eq_true.mp allBases_wfB'
  intro b hb
  rw [← wfB'_eq_wfB]
  exact h b hb

/-- **All 676 subgroups** of `Coordinate 2`, each a certified `Cgs`. -/
def allSubs : List (Cgs 2 hq2) :=
  allBases.attach.map (fun b => ⟨b.1, allBases_wfB b.1 b.2⟩)

/-- **The inventory has exactly 676 certified subgroups.** -/
theorem allSubs_length : allSubs.length = 676 := by
  simp only [allSubs, List.length_map, List.length_attach, allBases_card]

/-- **Every certified entry is a genuine subgroup of order `5^(length)`.** -/
theorem allSubs_orders (c : Cgs 2 hq2) (_ : c ∈ allSubs) :
    letI := coordinateGroup 2 hq2
    Nat.card c.toSubgroup = 5 ^ c.gens.length :=
  c.card_toSubgroup

/-- The generator lists of the certified `Cgs` are exactly `allBases`. -/
theorem allSubs_gens : allSubs.map Cgs.gens = allBases := by
  simp only [allSubs, List.map_map]
  exact List.attach_map_subtype_val allBases

/-- **Per-order strata of the certified inventory** = `[1,156,306,181,31,1]`. -/
theorem allSubs_strata :
    (List.range 6).map
        (fun k => (allSubs.filter (fun c => decide (c.gens.length = k))).length)
      = [1, 156, 306, 181, 31, 1] := by
  rw [← allBases_strata]
  refine List.map_congr_left (fun k _ => ?_)
  rw [← allSubs_gens, ← List.countP_eq_length_filter, ← List.countP_eq_length_filter,
    List.countP_map]
  rfl

