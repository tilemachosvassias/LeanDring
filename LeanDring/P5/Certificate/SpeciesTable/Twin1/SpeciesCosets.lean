/-! ## Boolean certificates over the embedded data -/

/-- Index into `allBases` of the rep `r`. -/
def spIdx (r : Nat) : Nat := classRepsData.getD r 0

/-- `g x g⁻¹` at the coordinate level. -/
def conjByC (g x : Coordinates) : Coordinates := mulC 1 (mulC 1 g x) (invC 1 g)

/-- `H' = hpData r` is a well-formed echelon pcgs. -/
def hpWfCheck (r : Nat) : Bool := wfB' 1 (hpData.getD r [])

/-- Every generator of `H'` sifts into `H = getB (spIdx r)`  (`H' ≤ H`). -/
def hpSubCheck (r : Nat) : Bool :=
  (hpData.getD r []).all (siftB 1 (getB (spIdx r)))

/-- Every generator-commutator `⁅bᵢ,bⱼ⁆` of `H` sifts into `H'`. -/
def commInCheck (r : Nat) : Bool :=
  let B := getB (spIdx r)
  B.all (fun a => B.all (fun b => siftB 1 (hpData.getD r []) (commutatorC a b)))

/-- `H'` is normalized by `H`: conjugates of `H'`-gens by `H`-gens (and inverses)
sift back into `H'`. -/
def hpNormalCheck (r : Nat) : Bool :=
  let B := getB (spIdx r)
  (hpData.getD r []).all (fun g => B.all (fun b =>
    siftB 1 (hpData.getD r []) (conjByC b g) &&
    siftB 1 (hpData.getD r []) (conjByC (invC 1 b) g)))

/-- `charCounts r · |H'| = |H|`, i.e. `|H'| = |H| / |H^ab|`. -/
def cardCheck (r : Nat) : Bool :=
  Nat.beq (charCounts.getD r 0 * 5 ^ (hpData.getD r []).length)
          (5 ^ (getB (spIdx r)).length)

/-- Every transversal element sifts into `H`. -/
def transMemCheck (r : Nat) : Bool :=
  (transData.getD r []).all (siftB 1 (getB (spIdx r)))

/-- The transversal is pairwise-distinct modulo `H'` (its reductions are Nodup). -/
def transDistinctCheck (r : Nat) : Bool :=
  let red := (transData.getD r []).map (reduceAux 1 (hpData.getD r []))
  Nat.beq red.dedup.length (transData.getD r []).length

/-- The transversal has `charCounts r = |H^ab|` elements. -/
def transCountCheck (r : Nat) : Bool :=
  Nat.beq (transData.getD r []).length (charCounts.getD r 0)

/-- All eight per-rep certificates bundled. -/
def speciesCheck (r : Nat) : Bool :=
  hpWfCheck r && hpSubCheck r && commInCheck r && hpNormalCheck r &&
  cardCheck r && transMemCheck r && transDistinctCheck r && transCountCheck r

/-! ## Whole-range kernel certificate -/

/-- Certificate over an explicit index range `[a, b)`. -/
def speciesCheckRange (a b : Nat) : Bool := ((List.range' a (b - a)).all speciesCheck)

theorem speciesChunk0 : speciesCheckRange 0 37 = true := by decide
theorem speciesChunk1 : speciesCheckRange 37 74 = true := by decide
theorem speciesChunk2 : speciesCheckRange 74 111 = true := by decide
theorem speciesChunk3 : speciesCheckRange 111 148 = true := by decide

end LeanDring.P5Presentation
