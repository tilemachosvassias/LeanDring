/-- Per-`(r,k,p)` coset-action fact: the emitted table entry `tab` is a valid
transversal index, the coset of `nₖ⁻¹ · T[p] · nₖ` is `T[tab]·H'`
(`(T[tab])⁻¹ · nₖ⁻¹ · T[p] · nₖ ∈ H'`), and its orbit label matches `p`'s. -/
def cosetActOK (r k p : Nat) : Bool :=
  Nat.blt (((cosetActData.getD r []).getD k []).getD p 0) (transData.getD r []).length &&
  siftB 2 (hpData.getD r [])
    (mulC 2 (invC 2 ((transData.getD r []).getD (((cosetActData.getD r []).getD k []).getD p 0) zc))
      (conjInvC ((normGens.getD r []).getD k zc) ((transData.getD r []).getD p zc))) &&
  Nat.beq ((cosetLabel.getD r []).getD (((cosetActData.getD r []).getD k []).getD p 0) 0)
    ((cosetLabel.getD r []).getD p 0)

/-- **Action + label-invariance check** for rep `r`: every generator's emitted
table is a genuine coset action of `N_G(H)`, and orbit labels are invariant. -/
def checkCosetAct (r : Nat) : Bool :=
  (List.range (cosetActData.getD r []).length).all (fun k =>
    (List.range (transData.getD r []).length).all (fun p => cosetActOK r k p))

/-- Per-`(r,p)` spanning-tree fact: coset `p` is either the orbit representative
(depth `0`, self-labelled) or has a valid parent one generator-step shallower. -/
def cosetTreeOK (r p : Nat) : Bool :=
  ((cosetIsRep.getD r []).getD p false &&
    (Nat.beq ((cosetTreeDepth.getD r []).getD p 0) 0 &&
      Nat.beq ((cosetLabel.getD r []).getD p 0) p)) ||
  (!((cosetIsRep.getD r []).getD p false) &&
    (Nat.blt ((cosetTreeGen.getD r []).getD p 0) (cosetActData.getD r []).length &&
     Nat.blt ((cosetTreePar.getD r []).getD p 0) (transData.getD r []).length &&
     Nat.blt ((cosetTreeDepth.getD r []).getD ((cosetTreePar.getD r []).getD p 0) 0)
       ((cosetTreeDepth.getD r []).getD p 0) &&
     Nat.beq (((cosetActData.getD r []).getD ((cosetTreeGen.getD r []).getD p 0) []).getD
       ((cosetTreePar.getD r []).getD p 0) 0) p &&
     Nat.beq ((cosetLabel.getD r []).getD ((cosetTreePar.getD r []).getD p 0) 0)
       ((cosetLabel.getD r []).getD p 0)))

/-- **BFS spanning-tree check** for rep `r`. -/
def checkCosetTree (r : Nat) : Bool :=
  (List.range (transData.getD r []).length).all (fun p => cosetTreeOK r p)

/-- Length sanity of the per-coset data. -/
def checkCosetLen (r : Nat) : Bool :=
  let n := (transData.getD r []).length
  Nat.beq (cosetLabel.getD r []).length n && Nat.beq (cosetIsRep.getD r []).length n &&
  Nat.beq (cosetTreeGen.getD r []).length n && Nat.beq (cosetTreePar.getD r []).length n &&
  Nat.beq (cosetTreeDepth.getD r []).length n &&
  Nat.beq (cosetActData.getD r []).length (normGens.getD r []).length

/-- All three per-rep coset-orbit certificates bundled. -/
def cosetOrbCheck (r : Nat) : Bool :=
  checkCosetAct r && checkCosetTree r && checkCosetLen r

/-- Certificate over an explicit index range `[a, b)`. -/
def cosetOrbCheckRange (a b : Nat) : Bool := ((List.range' a (b - a)).all cosetOrbCheck)

/-- Number of orbits of rep `r` = number of orbit representatives. -/
def cosetOrbitCountR (r : Nat) : Nat := ((cosetIsRep.getD r []).filter (· = true)).length

