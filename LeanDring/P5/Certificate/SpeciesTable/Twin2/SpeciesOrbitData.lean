/-- `n⁻¹ · t · n` at the coordinate level (orientation matching `normMats_realize`). -/
def conjInvC (n t : Coordinates) : Coordinates := mulC 2 (mulC 2 (invC 2 n) t) n

/-- Order (`1`, `5` or `25`) of the coset `t · H'` in `H/H'`, by sifting powers. -/
def cosetOrderC (Hp : List Coordinates) (t : Coordinates) : Nat :=
  if siftB 2 Hp t then 1 else if siftB 2 Hp (mpow 2 t 5) then 5 else 25

