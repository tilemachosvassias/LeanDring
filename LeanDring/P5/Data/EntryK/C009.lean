def R8 : Fin 625 → Coordinate 1 := fun i => R8list.getD i.val (0,0,0,0,0)

/-- `reduceAux`-proxy injectivity of the full 625-element transversal, via the
`O(n)` sorted-key `IsChain` route (`R8list` emitted sorted by `cKey`). -/
theorem hpxR8 : Function.Injective (fun i => reduceAux 1 (basisAt rK8) (R8 i)) :=
  injective_of_isChain_cKey _ (by decide)

/-- `|G/reps 8| = 625`. -/
theorem hcardq8 : Nat.card (Coordinate 1 ⧸ reps rK8) = 625 := by
  rw [card_quotient_reps]; decide

/-! ## Cell (8, 0): `H = ⊥`, abstract augmentation value `|G/K| = 625` -/

/-- **Cell (8, 0).** The augmentation row of the order-5 column: `φ_{⊥,1}[K,λ] =
|G/K| = 625`, independent of the certified character `e`.  Abstract — no transversal. -/
theorem cell8_0 (e : List (ZMod 25)) (heK : charOK (basisAt rK8) e = true)
    (h : ↥(reps (⟨0, by decide⟩ : Fin 148))) :
    species (reps (⟨0, by decide⟩ : Fin 148)) h (basisElt (reps rK8) (charOfVec rK8 e heK))
      = (625 : ℂ) := by
  have hbot : reps (⟨0, by decide⟩ : Fin 148) = (⊥ : Subgroup (Coordinate 1)) := reps_zero_eq_bot
  have hh1 : h = 1 := by
    apply Subtype.ext
    exact Subgroup.mem_bot.mp (hbot ▸ h.2)
  subst hh1
