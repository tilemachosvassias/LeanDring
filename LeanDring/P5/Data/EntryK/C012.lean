theorem hfix11_11_2 : ∀ i, ((T11_11_2 i : Coordinate 2) : Coordinate 2 ⧸ reps rK11)
    ∈ fixedPoints (reps rK11) (Coordinate 2 ⧸ reps rK11) :=
