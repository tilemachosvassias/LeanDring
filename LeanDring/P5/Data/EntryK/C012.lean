theorem hinj11_11_2 : Function.Injective
    (fun i => ((T11_11_2 i : Coordinate 2) : Coordinate 2 ⧸ reps rK11)) :=
  repsInj_of_reduceAux2 rK11 T11_11_2 (by decide)

theorem hcardT11_11_2 : Fintype.card (Fin 25)
    = Fintype.card (fixedPoints (reps rK11) (Coordinate 2 ⧸ reps rK11)) := by
  rw [Fintype.card_fin]
  exact (repsFixedCard2 rK11 rK11 R11_2 hpxR11_2 hcardq11_2 (by decide)).symm

/-- **Cell (11, 11) twin (q=2).** -/
theorem cell11_11_2 (e : List (ZMod 25)) (heK : charOK2 (basisAt2 rK11) e = true)
    (h : ↥(reps rK11)) :
    species (reps rK11) h (basisElt (reps rK11) (charOfVec2 rK11 e heK))
      = ∑ i : Fin 25, ((zeta25 : ℂˣ) : ℂ) ^ entryExp2 rK11 e (h : Coordinate 2) T11_11_2 i :=
