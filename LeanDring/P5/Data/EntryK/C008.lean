/-- `reduceAux`-proxy injectivity of the full 625-element transversal, via the
`O(n)` sorted-key `IsChain` route (`R7list` emitted sorted by `cKey`). -/
theorem hpxR7 : Function.Injective (fun i => reduceAux 1 (basisAt rK7) (R7 i)) :=
  injective_of_isChain_cKey _ (by decide)

/-- `|G/reps 7| = 625`. -/
theorem hcardq7 : Nat.card (Coordinate 1 ⧸ reps rK7) = 625 := by
  rw [card_quotient_reps]; decide

/-! ## Cell (7, 0): `H = ⊥`, abstract augmentation value `|G/K| = 625` -/

/-- **Cell (7, 0).** The augmentation row of the order-5 column: `φ_{⊥,1}[K,λ] =
|G/K| = 625`, independent of the certified character `e`.  Abstract — no transversal. -/
theorem cell7_0 (e : List (ZMod 25)) (heK : charOK (basisAt rK7) e = true)
    (h : ↥(reps (⟨0, by decide⟩ : Fin 148))) :
    species (reps (⟨0, by decide⟩ : Fin 148)) h (basisElt (reps rK7) (charOfVec rK7 e heK))
      = (625 : ℂ) := by
  have hbot : reps (⟨0, by decide⟩ : Fin 148) = (⊥ : Subgroup (Coordinate 1)) := reps_zero_eq_bot
  have hh1 : h = 1 := by
    apply Subtype.ext
    exact Subgroup.mem_bot.mp (hbot ▸ h.2)
  subst hh1
